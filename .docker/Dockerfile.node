FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

# systemd + SSH + the telemetry toolchain the cadet's role configures.
# All baked in so the role's "ensure present" tasks are network-free no-ops at
# grade time (the teaching stands; the apt round-trip does not).
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd systemd-sysv openssh-server \
    rsyslog auditd \
    python3 python3-requests \
    sudo iproute2 procps curl ca-certificates bsdutils \
    && rm -rf /var/lib/apt/lists/*

RUN systemctl mask \
    dev-hugepages.mount sys-fs-fuse-connections.mount \
    systemd-udev-trigger.service systemd-udevd.service \
    systemd-update-utmp.service getty@.service getty.target

# ssh + rsyslog run at boot; the cadet's role adds the FORWARD rule + restarts.
RUN systemctl enable ssh rsyslog
RUN mkdir -p /run/sshd /etc/sdc

# cadet: key-based access for Ansible (authorized_keys bind-mounted read-only)
RUN useradd -m -s /bin/bash cadet \
    && echo 'cadet ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers.d/cadet \
    && chmod 0440 /etc/sudoers.d/cadet \
    && mkdir -p /home/cadet/.ssh && chmod 700 /home/cadet/.ssh \
    && chown -R cadet:cadet /home/cadet/.ssh

EXPOSE 22
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
